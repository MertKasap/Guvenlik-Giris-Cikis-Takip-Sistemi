# Bu örneği .env olarak kopyalayın; gerçek şifreleri repoya yazmayın.
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:5173
DB_HOST=localhost
DB_PORT=3306
DB_NAME=security_entry_exit
DB_USER=replace_me
DB_PASSWORD=replace_me
JWT_SECRET=replace_with_random_secret_at_least_32_characters_long
QR_SIGNING_SECRET=replace_with_another_random_32_plus_character_secret
QR_TTL_SECONDS=60
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_unique_password_at_least_12_chars
# Sadece yönetici şifresini kurtarmak için geçici true; ardından false yapın.
ADMIN_PASSWORD_RESET_ON_START=false
