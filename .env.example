# Örnek yapılandırma, GERÇEK şifre veya token koymayın
NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# MySQL — örnek
DB_HOST=localhost
DB_PORT=3306
DB_NAME=security_entry_exit
DB_USER=replace_me
DB_PASSWORD=replace_me

# Sunucu anahtarları (.env dosyasında tutulmalı)
JWT_SECRET=replace_with_secure_random_secret
QR_SIGNING_SECRET=replace_with_another_secure_random_secret
QR_TOKEN_TTL_SECONDS=60
SESSION_COOKIE_SECURE=false
